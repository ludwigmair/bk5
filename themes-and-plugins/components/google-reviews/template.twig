<section id="{{ id }}">
    <div class="mx-auto max-w-6xl px-4 py-20 md:px-8">
        {% if kicker %}
        <p class="font-display text-xs font-medium uppercase tracking-[0.28em] text-primary">{{ kicker }}</p>
        {% endif %}
        <h2 class="mt-2 font-display text-3xl font-semibold md:text-4xl">{{ heading }}</h2>
        {% if rating_summary and (show_rating_summary is not defined or show_rating_summary) %}
        <p class="mt-3 flex items-center gap-2 text-sm">
            <span class="relative inline-block font-display tracking-widest text-secondary/25" aria-hidden="true">
                ★★★★★
                <span class="absolute inset-0 overflow-hidden text-secondary" style="width: {{ (rating_summary.rating / 5 * 100)|round(1) }}%">★★★★★</span>
            </span>
            <span class="font-semibold">{{ rating_summary.rating }}</span>
            <span class="text-walnut/60">· {{ rating_summary.count }} Bewertungen</span>
        </p>
        {% endif %}
        {% if intro %}
        <div class="mt-6 flex items-start gap-3 rounded-[var(--brand-radius)] border border-walnut/10 bg-ash/60 px-5 py-4 text-sm leading-relaxed text-walnut/70">
            <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8v.01" stroke-linecap="round"/></svg>
            <p>{{ intro|rich }}</p>
        </div>
        {% endif %}
        <div class="swiper mt-10" data-reviews-swiper>
            <div class="swiper-wrapper">
                {% for review in reviews|filter(review => review.active is not defined or review.active) %}
                <div class="swiper-slide h-auto">
                    <blockquote class="flex h-full flex-col rounded-[var(--brand-radius)] border border-walnut/10 bg-ash/60 p-6">
                        <div class="flex items-center gap-3">
                            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-secondary font-display text-base text-white">{{ review.author|default('?')|first|upper }}</span>
                            <div class="min-w-0">
                                <p class="truncate font-display text-sm font-semibold text-primary">{{ review.author }}</p>
                                {% if review.time %}<p class="text-xs text-walnut/50">{{ review.time }}</p>{% endif %}
                            </div>
                        </div>
                        <p class="mt-4 font-display text-sm tracking-widest text-secondary" aria-label="{{ review.rating|default(5) }} von 5 Sternen">
                            {% for i in 1..(review.rating|default(5)) %}★{% endfor %}
                        </p>
                        <p class="mt-3 flex-1 leading-relaxed text-walnut/80">{{ review.text|rich }}</p>
                    </blockquote>
                </div>
                {% endfor %}
            </div>
        </div>
        {% if reviews|filter(review => review.active is not defined or review.active)|length > 1 %}
        <div class="mt-8 flex items-center justify-center gap-4">
            <button type="button" class="swiper-nav-btn review-nav-arrow" data-reviews-prev aria-label="Vorherige Bewertung">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="swiper-pagination swiper-pagination-dark !relative !w-auto"></div>
            <button type="button" class="swiper-nav-btn review-nav-arrow review-nav-arrow--next" data-reviews-next aria-label="Nächste Bewertung">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
        </div>
        {% endif %}
        {% if reviews_url and (show_reviews_button is not defined or show_reviews_button) %}
        <div class="mt-10 text-center">
            <a class="inline-flex h-12 cursor-pointer items-center rounded-[var(--brand-radius)] bg-primary px-8 text-sm font-semibold uppercase tracking-[0.12em] text-white transition hover:brightness-110" href="{{ reviews_url }}" target="_blank" rel="noopener noreferrer">{{ reviews_url_label|default('Alle Google-Bewertungen lesen') }}</a>
        </div>
        {% endif %}
    </div>
</section>
