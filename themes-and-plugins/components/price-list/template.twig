<section id="{{ id }}" class="mx-auto max-w-4xl px-4 py-20 md:px-8">
    {% if kicker %}
    <p class="font-display text-xs font-medium uppercase tracking-[0.28em] text-secondary">{{ kicker }}</p>
    {% endif %}
    {% if heading %}
    <h2 class="mt-2 font-display text-3xl font-semibold md:text-4xl">{{ heading }}</h2>
    {% endif %}
    {% if subheading %}
    <p class="mt-3 text-sm font-semibold uppercase tracking-[0.18em] text-secondary/80">{{ subheading }}</p>
    {% endif %}
    {% if intro %}
    <p class="mt-4 max-w-2xl leading-relaxed text-walnut/75">{{ intro|rich }}</p>
    {% endif %}

    {% set activeGroups = groups|default([])|filter(group => group.active is not defined or group.active) %}
    {% for group in activeGroups %}
    <div class="mt-12">
        {% if group.caption %}
        <h3 class="text-xs font-semibold uppercase tracking-[0.24em] text-secondary">{{ group.caption }}</h3>
        <span class="mt-3 block h-0.5 w-8 rounded-full bg-secondary/60" aria-hidden="true"></span>
        {% endif %}
        <ul class="{% if group.caption %}mt-6{% else %}mt-2{% endif %} space-y-4">
            {% for row in group.rows|default([])|filter(row => row.active is not defined or row.active) %}
            <li class="flex items-baseline gap-3">
                <div class="min-w-0">
                    <p class="font-semibold text-walnut">{{ row.name }}</p>
                    {% if row.description %}
                    <p class="mt-0.5 text-sm leading-relaxed text-walnut/65">{{ row.description }}</p>
                    {% endif %}
                </div>
                <span class="mx-1 flex-1 self-center border-b border-dotted border-walnut/25" aria-hidden="true"></span>
                <p class="shrink-0 whitespace-nowrap font-semibold tabular-nums text-walnut">{{ row.price }}</p>
            </li>
            {% endfor %}
        </ul>
    </div>
    {% endfor %}

    {% if notes %}
    <div class="mt-14 rounded-[var(--brand-radius)] border border-walnut/10 bg-white/70 p-6 md:p-8">
        <div class="text-sm leading-relaxed text-walnut/75">{{ notes|rich_block }}</div>
    </div>
    {% endif %}
</section>