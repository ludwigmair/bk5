      // ——— KI-Buttons: data-ai-rewrite an ai_supported-Feldern, data-ai-seo im SEO-Panel, data-open-special für sitemap/robots ———
      function activeAdminLang() {
        var active = document.querySelector('[data-lang-switch].bg-\\[\\#355E4B\\]');
        return active ? active.getAttribute('data-lang-switch') : 'de';
      }

      function aiFetch(params, done) {
        var body = new FormData();
        body.append('csrf', '{{ csrf }}');
        Object.keys(params).forEach(function (k) { body.append(k, params[k]); });
        fetch('?admin=1', { method: 'POST', body: body })
          .then(function (r) { return r.json(); })
          .then(function (json) { done(json); })
          .catch(function () { done({ ok: false, message: 'Verbindung fehlgeschlagen.' }); });
      }

      function clearAiSuggest() {
        var box = document.querySelector('[data-ai-suggest]');
        if (box) box.remove();
      }

      document.addEventListener('click', function (e) {
        var openBtn = e.target.closest('[data-open-special]');
        if (openBtn) {
          e.preventDefault();
          window.open(location.origin + '/' + openBtn.getAttribute('data-open-special'), '_blank');
          return;
        }

        var rewriteBtn = e.target.closest('[data-ai-rewrite]');
        if (rewriteBtn) {
          var wrap = rewriteBtn.closest('[data-lang-panel], [data-field-wrap]');
          var input = wrap ? (wrap.querySelector('textarea') || wrap.querySelector('input:not([type="hidden"])')) : null;
          if (!input) return;
          clearAiSuggest();
          var panel = rewriteBtn.closest('.section-panel');
          var h2 = panel && panel.querySelector('h2');
          var lang = wrap ? (wrap.getAttribute('data-lang-panel') || activeAdminLang()) : activeAdminLang();

          var label = rewriteBtn.getAttribute('data-ai-label') || 'Text';
          var prevIcon = rewriteBtn.textContent;
          rewriteBtn.disabled = true;
          rewriteBtn.textContent = '…';
          aiFetch({
            do: 'ai-rewrite',
            label: label,
            value: input.value || '',
            lang: lang,
            section: h2 ? h2.textContent.trim() : ''
          }, function (result) {
            rewriteBtn.disabled = false;
            rewriteBtn.textContent = prevIcon;
            if (!result.ok) { alert(result.message || 'KI-Anfrage fehlgeschlagen.'); return; }
            var list = result.alternatives || [];
            if (!list.length) { alert('Keine Vorschläge erhalten.'); return; }
            var box = document.createElement('div');
            box.setAttribute('data-ai-suggest', '');
            box.className = 'mt-1.5 space-y-1.5 rounded-xl border border-[#6D4AA3]/25 bg-[#6D4AA3]/5 p-2.5';
            var head = document.createElement('p');
            head.className = 'text-[11px] font-semibold uppercase tracking-[0.08em] text-[#6D4AA3]/80';
            head.textContent = 'KI-Vorschläge – Klick übernimmt';
            box.appendChild(head);
            list.forEach(function (alt) {
              var btn = document.createElement('button');
              btn.type = 'button';
              btn.className = 'block w-full cursor-pointer rounded-lg border border-[#6D4AA3]/20 bg-white px-3 py-2 text-left text-[13px] text-[#241E18]/80 transition hover:border-[#6D4AA3]/50 hover:text-[#241E18]';
              btn.textContent = alt;
              btn.addEventListener('click', function () {
                input.value = alt;
                input.dispatchEvent(new Event('change', { bubbles: true }));
                clearAiSuggest();
              });
              box.appendChild(btn);
            });
            (wrap || rewriteBtn).after(box);
          });
          return;
        }

        var seoBtn = e.target.closest('[data-ai-seo]');
        if (seoBtn) {
          var outWrap = document.querySelector('[data-ai-seo-results]');
          if (!outWrap) return;
          var oldText = seoBtn.textContent;
          seoBtn.disabled = true;
          seoBtn.textContent = 'Generiert …';
          aiFetch({ do: 'ai-seo', lang: activeAdminLang() }, function (result) {
            seoBtn.disabled = false;
            seoBtn.textContent = oldText;
            outWrap.innerHTML = '';
            if (!result.ok) { alert(result.message || 'KI-Anfrage fehlgeschlagen.'); return; }
            var list = result.suggestions || [];
            if (!list.length) { alert('Keine Vorschläge erhalten.'); return; }
            var note = document.createElement('p');
            note.className = 'mt-1 text-[11px] text-[#6D4AA3]/70';
            note.textContent = 'Vorschlag anklicken füllt Titel, Beschreibung und OG-Felder – danach unten speichern.';
            outWrap.appendChild(note);
            list.forEach(function (s) {
              var btn = document.createElement('button');
              btn.type = 'button';
              btn.className = 'mt-1.5 block w-full cursor-pointer rounded-lg border border-[#6D4AA3]/20 bg-white px-3 py-2 text-left transition hover:border-[#6D4AA3]/50';
              var title = document.createElement('span');
              title.className = 'block text-[13px] font-semibold text-[#241E18]';
              title.textContent = s.title || '—';
              var desc = document.createElement('span');
              desc.className = 'block text-xs text-[#241E18]/60';
              desc.textContent = s.description || '';
              btn.appendChild(title);
              btn.appendChild(desc);
              btn.addEventListener('click', function () {
                ['title', 'description', 'og_title', 'og_description'].forEach(function (name) {
                  var el = document.querySelector('input[name="seo[' + name + ']"], textarea[name="seo[' + name + ']"]');
                  if (el) el.value = name === 'og_title' ? (s.title || '') : name === 'og_description' ? (s.description || '') : name === 'title' ? (s.title || '') : (s.description || '');
                });
              });
              outWrap.appendChild(btn);
            });
          });
          return;
        }
      });

      document.addEventListener('click', function (e) {
