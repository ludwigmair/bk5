<section id="{{ id }}" class="mx-auto max-w-6xl px-4 py-20 md:px-8">
    {% if kicker %}
    <p class="font-display text-xs font-medium uppercase tracking-[0.28em] text-primary">{{ kicker }}</p>
    {% endif %}
    {% if heading %}
    <h2 class="mt-2 font-display text-3xl font-semibold md:text-4xl">{{ heading }}</h2>
    {% endif %}

    <div class="{% if kicker or heading %}mt-10{% endif %} grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {% for cat in categories %}
        {% if cat.active is not defined or cat.active %}
        {% set catImages = cat.images|default([])|filter(img => img.active is not defined or img.active) %}
        {% if catImages|length == 0 and cat.cover_image %}
        {% set catImages = [{'image': cat.cover_image, 'alt': cat.name|default('')}] %}
        {% endif %}
        {% for img in catImages %}
        {% set pic = img_src(img.image, 800) %}
        <figure class="overflow-hidden rounded-[var(--brand-radius)]">
            <img class="aspect-[4/3] w-full object-cover transition duration-300 hover:scale-105" src="{{ pic.src }}" srcset="{{ pic.srcset }}" {% if pic.width %}width="{{ pic.width }}"{% endif %} {% if pic.height %}height="{{ pic.height }}"{% endif %} alt="{{ img.alt|default('') }}" loading="lazy">
        </figure>
        {% endfor %}
        {% endif %}
        {% endfor %}
    </div>
</section>
