<footer class="bg-walnut text-white">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-4 py-10 sm:grid-cols-3 md:px-8">
        <div>
            <p class="font-display text-base font-semibold">{{ site.logo_text|default(site.title) }}</p>
            {% if content.business.street or content.business.city %}
            <p class="mt-2 text-sm text-white/70">
                {{ content.business.street|default('') }}{% if content.business.street %}<br>{% endif %}
                {{ content.business.zip|default('') }} {{ content.business.city|default('') }}
            </p>
            {% endif %}
        </div>
        <div class="text-sm text-white/70">
            {% if content.business.phone %}
            <p>{{ content.footer.phone_label|default('Tel.') }} <a class="text-white hover:text-secondary" href="tel:{{ content.business.phone|replace({' ': ''}) }}">{{ content.business.phone }}</a></p>
            {% endif %}
            {% if content.business.email %}
            <p class="mt-1"><a class="text-white hover:text-secondary" href="mailto:{{ content.business.email }}" data-mail-template data-mail-address="{{ content.business.email }}" data-mail-subject="{{ content.labels.mail_subject|default('') }}" data-mail-body="{{ content.labels.mail_body|default('') }}">{{ content.business.email }}</a></p>
            {% endif %}
        </div>
        <div class="text-sm text-white/70">
            {% if content.business.owner %}
            <p>{{ content.footer.owner_label|default('Inhaber') }} {{ content.business.owner }}</p>
            {% endif %}
            <p class="mt-2 flex gap-3">
                <a class="hover:text-secondary" href="/impressum">{{ content.labels.footer_impressum|default('Impressum') }}</a>
                <span aria-hidden="true">·</span>
                <a class="hover:text-secondary" href="/datenschutz">{{ content.labels.footer_datenschutz|default('Datenschutz') }}</a>
            </p>
        </div>
    </div>
    <div class="border-t border-white/10">
        <div class="mx-auto max-w-6xl px-4 py-4 text-xs text-white/50 md:px-8">
            <p>© {{ year }} {{ site.title|default('') }}</p>
        </div>
    </div>
</footer>
