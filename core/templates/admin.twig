                                <input class="mt-1 block h-10 w-36 rounded-lg border border-transparent bg-[#241E18]/[0.035] px-2.5 text-sm font-normal normal-case tracking-normal text-[#241E18] outline-none transition focus:border-[#355E4B]/30 focus:bg-white focus:ring-4 focus:ring-[#355E4B]/10" type="text" name="version" placeholder="z. B. 1.1.0" pattern="\d+\.\d+\.\d+" required {% if not components_update_pending %}disabled{% endif %}>
