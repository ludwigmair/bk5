                                    <span class="font-semibold text-[#241E18]">{{ instance.name }} <span class="text-[11px] font-normal text-[#241E18]/40">Port {{ instance.port }}</span></span>
                                    <span class="truncate text-[11px] text-[#241E18]/50">{{ instance.path }}{% if not instance.exists %} <span class="text-red-500">(Ordner fehlt)</span>{% endif %}</span>
                                </span>
                                <button class="h-9 cursor-pointer rounded-lg bg-[#B87333] px-4 text-sm font-semibold text-white transition hover:brightness-110" type="submit" {% if not instance.exists %}disabled title="Ziel-Ordner existiert nicht"{% endif %}>Angleichen</button>
                            </form>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}

                    <div class="rounded-xl border border-[#241E18]/10 bg-white p-4">
                        <p class="font-semibold text-[#241E18]">Theme &amp; Daten als Paket exportieren</p>
                        <p class="mt-1 text-xs text-[#241E18]/50">Zippt den aktuellen Stand (Inhalte, Einstellungen, Bilder, aktives Theme <strong>{{ active_theme|default('–') }}</strong> und verwendete Components) samt Prüfsummen-Manifest nach <code>cache/</code> – als transportables Gegenstück zum Sync, z. B. für Instanzen außerhalb dieses Rechners. In der Ziel-Instanz einfach unter „Projekt-Paket importieren“ hochladen.</p>
                        <form class="mt-3 flex flex-wrap items-center gap-3" method="post">
                            <input type="hidden" name="csrf" value="{{ csrf }}">
                            <input type="hidden" name="do" value="build-project-package">
                            <button class="h-10 cursor-pointer rounded-lg bg-[#B87333] px-4 text-sm font-semibold text-white transition hover:brightness-110" type="submit">Paket erstellen</button>
                        </form>
                        {% if project_packages is not empty %}
                        <div class="mt-3 space-y-2">
                            {% for pkg in project_packages %}
                            <div class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-[#241E18]/10 bg-[#241E18]/[0.02] px-3 py-2">
                                <span class="min-w-0 flex flex-col">
                                    <span class="font-semibold text-[#241E18]">{{ pkg.file }}</span>
