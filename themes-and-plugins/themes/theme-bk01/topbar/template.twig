<div class="bg-walnut text-ash">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-2 text-sm md:px-8">
        <div class="flex min-w-0 items-center gap-4">
            {% if phone %}
            <a class="flex shrink-0 items-center gap-2 font-semibold text-ash hover:text-secondary" href="tel:{{ phone|replace({' ': ''}) }}">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2a1 1 0 0 1 1.1-.2c1.2.5 2.5.8 3.8.8a1 1 0 0 1 1 1v3.4a1 1 0 0 1-1 1C10.6 21.2 2.8 13.4 2.8 3.7a1 1 0 0 1 1-1H7.2a1 1 0 0 1 1 1c0 1.3.3 2.6.8 3.8a1 1 0 0 1-.2 1.1L6.6 10.8Z"/></svg>
                {{ phone }}
            </a>
            {% endif %}
            {% if text %}
            <span class="hidden truncate text-ash/70 sm:block">{{ text }}</span>
            {% endif %}
        </div>
        {% if cta_label and cta_href %}
        <a class="shrink-0 rounded-[6px] bg-secondary px-4 py-1.5 text-xs font-semibold uppercase tracking-wide text-white transition hover:brightness-110" href="{{ cta_href }}">{{ cta_label }}</a>
        {% endif %}
    </div>
</div>
