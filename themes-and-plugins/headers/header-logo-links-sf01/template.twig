<header class="sticky top-0 z-40 border-b border-walnut/10 bg-white/95 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 md:gap-8 md:px-8">
        <a href="{{ locale_prefix }}/#top" class="shrink-0 flex items-center gap-3 font-display text-xl font-semibold tracking-tight text-walnut">
            {% if site.logo_image|default('') %}
            <img class="h-12 w-auto" src="{{ site.logo_image starts with 'http' ? site.logo_image : '/' ~ site.logo_image }}" alt="{{ site.logo_text|default(site.title) }}" loading="eager">
            {% endif %}
            <span>{{ site.logo_text|default(site.title) }}</span>
        </a>
        <button type="button" class="inline-flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-[10px] border border-walnut/20 md:hidden" data-nav-toggle aria-expanded="false" aria-controls="site-nav">
            <span class="sr-only">{{ content.labels.nav_menu|default('Menü') }}</span>
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/>
            </svg>
        </button>
        <nav id="site-nav" class="absolute left-0 right-0 top-full hidden border-b border-walnut/10 bg-white px-4 py-4 md:static md:block md:flex-1 md:border-0 md:bg-transparent md:p-0">
            <ul class="flex flex-col gap-3 font-display md:flex-row md:items-center md:justify-center md:gap-7">
                {% for item in nav %}
                {% if item.active is not defined or item.active %}
                <li><a class="text-sm font-medium tracking-wide text-walnut/80 hover:text-primary" href="{{ item.href starts with '#' ? locale_prefix ~ '/' ~ item.href : item.href }}">{{ item.label }}</a></li>
                {% endif %}
                {% endfor %}
            </ul>
        </nav>
        {% if content.business.phone|default('') %}
        <a class="hidden shrink-0 items-center gap-2 rounded-[10px] bg-ash px-4 py-2.5 text-sm font-semibold text-primary transition hover:brightness-95 md:inline-flex" href="tel:{{ content.business.phone|replace({' ': ''}) }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2a1 1 0 0 1 1.1-.2c1.2.5 2.5.8 3.8.8a1 1 0 0 1 1 1v3.4a1 1 0 0 1-1 1C10.6 21.2 2.8 13.4 2.8 3.7a1 1 0 0 1 1-1H7.2a1 1 0 0 1 1 1c0 1.3.3 2.6.8 3.8a1 1 0 0 1-.2 1.1L6.6 10.8Z"/></svg>
            {{ content.business.phone }}
        </a>
        {% endif %}
    </div>
</header>
<script>
  (function () {
    var btn = document.querySelector('[data-nav-toggle]');
    var nav = document.getElementById('site-nav');
    if (!btn || !nav) return;
    btn.addEventListener('click', function () {
      var open = nav.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    nav.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', function () {
        if (!nav.classList.contains('hidden')) {
          nav.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
        }
      });
    });
  })();
</script>
