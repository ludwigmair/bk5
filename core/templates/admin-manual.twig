<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Benutzerhandbuch · {{ site_name }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Commissioner:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      .manual h1 { font-family: 'Commissioner', sans-serif; font-weight: 600; font-size: 1.75rem; margin: 0 0 0.5rem; }
      .manual h2 { font-family: 'Commissioner', sans-serif; font-weight: 600; font-size: 1.3rem; margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid rgba(36,30,24,.08); }
      .manual h2:first-child { border-top: 0; padding-top: 0; margin-top: 0; }
      .manual h3 { font-family: 'Commissioner', sans-serif; font-weight: 600; font-size: 1.05rem; margin: 1.5rem 0 0.5rem; }
      .manual p { margin: 0 0 0.9rem; line-height: 1.65; color: rgba(36,30,24,.85); }
      .manual ul { margin: 0 0 0.9rem; padding-left: 1.25rem; list-style: disc; line-height: 1.65; color: rgba(36,30,24,.85); }
      .manual li { margin: 0 0 0.25rem; }
      .manual code { background: rgba(36,30,24,.06); border-radius: 4px; padding: 0.1rem 0.35rem; font-size: 0.9em; }
      .manual a { color: #355E4B; text-decoration: underline; }
      .manual strong { font-weight: 600; }
      .md-table-wrap { overflow-x: auto; margin: 0 0 1rem; }
      .manual table { border-collapse: collapse; width: 100%; font-size: 0.92rem; }
      .manual th, .manual td { border: 1px solid rgba(36,30,24,.1); padding: 0.5rem 0.7rem; text-align: left; vertical-align: top; }
      .manual th { background: rgba(36,30,24,.04); font-family: 'Commissioner', sans-serif; font-weight: 600; }
    </style>
</head>
<body class="bg-[#E7E4DC] font-['IBM_Plex_Sans',sans-serif] text-[#241E18]">
    <header class="sticky top-0 z-20 border-b border-[#241E18]/10 bg-[#FBF8F2]">
        <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#B87333]">Benutzerhandbuch</p>
                <h1 class="font-['Commissioner',sans-serif] text-xl font-semibold tracking-tight">{{ site_name }}</h1>
            </div>
            <div class="flex items-center gap-3 text-sm">
                <span class="text-[#241E18]/60">Angemeldet als {{ current_user }}</span>
                <a class="underline" href="?admin=1">Zurück zum Dashboard</a>
            </div>
        </div>
    </header>
    {% if toc is not empty %}
    <nav class="mx-auto mt-6 flex max-w-3xl flex-wrap gap-2 px-4" aria-label="Sprung zu einem Abschnitt">
        {% for item in toc %}
        <a class="rounded-full border border-[#241E18]/10 bg-[#FBF8F2] px-3 py-1 text-sm text-[#241E18]/75 no-underline transition hover:border-[#355E4B]/40 hover:bg-[#355E4B]/5 hover:text-[#355E4B]" href="#{{ item.slug }}">{{ item.text }}</a>
        {% endfor %}
    </nav>
    {% endif %}
    <main class="manual mx-auto max-w-3xl px-4 py-10">
        {{ html|raw }}
    </main>
</body>
</html>
