<div class="fixed inset-x-4 bottom-4 z-50 mx-auto hidden max-w-md rounded-[10px] border border-walnut/10 bg-white p-5 shadow-2xl" data-cookie-banner>
    <p class="text-sm text-walnut/75">{{ content.labels.cookie_text|default('Diese Website verwendet nur technisch notwendige Cookies.') }}</p>
    <div class="mt-4 flex flex-wrap gap-3">
        <button type="button" class="h-9 cursor-pointer rounded-[6px] bg-secondary px-4 text-sm font-semibold text-white transition hover:brightness-110" data-cookie-accept>{{ content.labels.cookie_accept|default('Verstanden') }}</button>
        <button type="button" class="h-9 cursor-pointer rounded-[6px] border border-walnut/15 px-4 text-sm font-medium transition hover:bg-walnut/5" data-cookie-necessary>{{ content.labels.cookie_necessary|default('Nur notwendige') }}</button>
    </div>
    <a class="mt-3 block text-xs text-walnut/50 underline hover:text-secondary" href="/datenschutz">{{ content.labels.cookie_privacy_link|default('Datenschutzerklärung') }}</a>
</div>
