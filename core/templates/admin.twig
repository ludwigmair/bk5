                                    <code class="flex-1 select-all break-all rounded-lg border border-[#241E18]/10 bg-[#241E18]/[0.03] px-2.5 py-2 font-mono text-xs text-[#241E18]/80" data-copy-source>php dev/build-release.php {{ pkg.version }} --repo ludwigmair/onepage-cms-releases</code>
                                    <button type="button" data-copy-command title="In Zwischenablage kopieren" class="shrink-0 cursor-pointer rounded-lg border border-[#355E4B]/30 px-2.5 text-xs font-semibold text-[#355E4B] transition hover:bg-[#355E4B]/5">Kopieren</button>
                                </div>
                            </label>
                        </div>
                        {% endfor %}
                    </div>
                    {% endif %}
                </section>
                {% endif %}

                {% if has_dev_tools %}
                <section id="panel-components-update" class="section-panel space-y-4 rounded-xl border border-[#241E18]/5 border-l-4 border-l-[#B87333]/60 bg-[#FBF8F2] shadow-sm shadow-[#241E18]/[0.03] p-5" data-panel="panel-components-update" hidden>
                    <h2 class="font-['Commissioner',sans-serif] text-lg font-semibold tracking-tight">Components-Update-Paket erstellen</h2>
