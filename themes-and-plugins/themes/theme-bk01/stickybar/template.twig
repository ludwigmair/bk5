<div class="fixed right-4 top-1/2 z-40 hidden -translate-y-1/2 flex-col overflow-hidden rounded-[10px] border border-[#DBD0BA] bg-white shadow-[0_6px_20px_rgba(31,42,36,0.14)] md:flex">
    {% if content.business.phone|default('') %}
    <a class="flex flex-col items-center gap-1 px-4 py-3 text-secondary transition hover:bg-ash/50" href="tel:{{ content.business.phone|replace({' ': ''}) }}" title="Anrufen">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2a1 1 0 0 1 1.1-.2c1.2.5 2.5.8 3.8.8a1 1 0 0 1 1 1v3.4a1 1 0 0 1-1 1C10.6 21.2 2.8 13.4 2.8 3.7a1 1 0 0 1 1-1H7.2a1 1 0 0 1 1 1c0 1.3.3 2.6.8 3.8a1 1 0 0 1-.2 1.1L6.6 10.8Z"/></svg>
        <span class="text-xs font-medium">{{ content.labels.sticky_call|default('Anrufen') }}</span>
    </a>
    <div class="h-px bg-walnut/10"></div>
    {% endif %}
    {% if content.business.email|default('') %}
    <a class="flex flex-col items-center gap-1 px-4 py-3 text-secondary transition hover:bg-ash/50" href="mailto:{{ content.business.email }}" title="E-Mail schreiben" data-mail-template data-mail-address="{{ content.business.email }}" data-mail-subject="{{ content.labels.mail_subject|default('') }}" data-mail-body="{{ content.labels.mail_body|default('') }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6 8.5 7 8.5-7"/></svg>
        <span class="text-xs font-medium">{{ content.labels.sticky_mail|default('Mail') }}</span>
    </a>
    <div class="h-px bg-walnut/10"></div>
    {% endif %}
    {% if contact_id|default('') %}
    <a class="flex flex-col items-center gap-1 px-4 py-3 text-secondary transition hover:bg-ash/50" href="/#{{ contact_id }}" title="Zur Anfrage">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H8l-4 4V5Z"/></svg>
        <span class="text-xs font-medium">{{ content.labels.sticky_inquiry|default('Anfrage') }}</span>
    </a>
    <div class="h-px bg-walnut/10"></div>
    {% endif %}
    <a class="flex flex-col items-center gap-1 px-4 py-3 text-secondary transition hover:bg-ash/50" href="#top" title="Nach oben">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5.5 11.5 12 5l6.5 6.5"/></svg>
        <span class="text-xs font-medium">{{ content.labels.sticky_top|default('Nach oben') }}</span>
    </a>
</div>
