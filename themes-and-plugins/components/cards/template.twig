{% set activeItems = items|default([])|filter(item => item.active is not defined or item.active) %}

<section id="{{ id }}" class="mx-auto max-w-6xl px-4 py-20 md:px-8">
    {% if kicker %}
    <p class="font-display text-xs font-medium uppercase tracking-[0.28em] text-primary">{{ kicker }}</p>
    {% endif %}
    {% if heading %}
    <h2 class="mt-2 font-display text-3xl font-semibold md:text-4xl">{{ heading }}</h2>
    {% endif %}
    {% if lead %}
    <p class="mt-4 max-w-2xl leading-relaxed text-walnut/75">{{ lead|rich }}</p>
    {% endif %}

    <div class="{% if heading or kicker or lead %}mt-10{% endif %} grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {% for item in activeItems %}
        <div class="overflow-hidden rounded-[var(--brand-radius)] border border-walnut/15 bg-ash/50">
            {% if item.media_type == 'icon' %}
                {% if item.icon %}
                <div class="px-5 pt-5 {% if item.icon_position == 'center' %}flex justify-center{% elseif item.icon_position == 'right' %}flex justify-end{% endif %}">
                    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-[var(--brand-radius)] bg-primary/10 text-primary [&>svg]:h-6 [&>svg]:w-6">
                        {{ icon(item.icon)|raw }}
                    </span>
                </div>
                {% endif %}
            {% elseif item.media_type == 'number' %}
                <div class="px-5 pt-5 {% if item.icon_position == 'center' %}flex justify-center{% elseif item.icon_position == 'right' %}flex justify-end{% endif %}">
                    <span class="font-display text-2xl font-semibold text-primary/40">{{ '%02d'|format(loop.index) }}</span>
                </div>
            {% elseif item.image %}
            <img class="h-44 w-full object-cover" src="{{ item.image starts with 'http' ? item.image : '/' ~ item.image }}" alt="{{ item.title|default('') }}" loading="lazy">
            {% endif %}
            <div class="px-5 py-5">
                {% if item.title %}<h3 class="font-display text-lg font-semibold">{{ item.title }}</h3>{% endif %}
                {% if item.subtitle %}<p class="mt-1 text-sm uppercase tracking-wide text-walnut/50">{{ item.subtitle }}</p>{% endif %}
                {% if item.text %}<div class="mt-2 text-sm leading-relaxed text-walnut/70">{{ item.text|rich_block }}</div>{% endif %}
            </div>
        </div>
        {% endfor %}
    </div>
</section>
