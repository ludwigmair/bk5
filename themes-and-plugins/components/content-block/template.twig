{% set activeItems = items|default([])|filter(item => item.active is not defined or item.active) %}
{% set layout = layout|default('columns-1') %}

<section id="{{ id }}" class="mx-auto max-w-6xl px-4 py-20 md:px-8">
    {% if kicker %}
    <p class="font-display text-xs font-medium uppercase tracking-[0.28em] text-primary">{{ kicker }}</p>
    {% endif %}
    {% if heading %}
    <h2 class="mt-2 font-display text-3xl font-semibold md:text-4xl">{{ heading }}</h2>
    {% endif %}

    {% if layout in ['image-left', 'image-right'] %}
        {% set item = activeItems|first %}
        {% set imageBlock %}
        {% if item.person_name %}
        <div class="rounded-[var(--brand-radius)] border border-walnut/10 bg-white p-6 text-center shadow-sm">
            {% if item.image %}
            <img class="h-[180px] w-full rounded-[var(--brand-radius)] object-cover" src="{{ item.image starts with 'http' ? item.image : '/' ~ item.image }}" alt="{{ item.person_name }}" loading="lazy">
            {% endif %}
            <p class="{% if item.image %}mt-4{% endif %} font-semibold">{{ item.person_name }}</p>
            {% if item.person_role %}<p class="mt-1 text-sm text-secondary">{{ item.person_role }}</p>{% endif %}
            {% if item.cta_label and item.cta_href %}
            <a class="mt-4 flex h-[54px] w-full cursor-pointer items-center justify-center rounded-[var(--brand-radius)] border-2 border-secondary text-lg font-semibold text-secondary transition hover:bg-secondary/5" href="{{ item.cta_href }}">{{ item.cta_label }}</a>
            {% endif %}
        </div>
        {% elseif item.image %}
        <img class="h-full w-full rounded-[var(--brand-radius)] object-cover" src="{{ item.image starts with 'http' ? item.image : '/' ~ item.image }}" alt="{{ item.title|default('') }}" loading="lazy">
        {% endif %}
        {% endset %}
        {% set textBlock %}
        <div>
            {% if item.title %}<h3 class="font-display text-2xl font-semibold">{{ item.title }}</h3>{% endif %}
            {% if item.subtitle %}<p class="mt-1 text-sm uppercase tracking-wide text-walnut/50">{{ item.subtitle }}</p>{% endif %}
            {% if item.text %}<div class="mt-4 leading-relaxed text-walnut/75">{{ item.text|rich_block }}</div>{% endif %}
        </div>
        {% endset %}
        <div class="{% if heading or kicker %}mt-10{% endif %} grid items-start gap-10 {% if item.person_name %}md:grid-cols-[1fr_320px]{% else %}md:grid-cols-2{% endif %}">
            {% if layout == 'image-right' %}{{ textBlock }}{{ imageBlock }}{% else %}{{ imageBlock }}{{ textBlock }}{% endif %}
        </div>

    {% elseif layout == 'image-bottom' %}
        {% set item = activeItems|first %}
        <div class="{% if heading or kicker %}mt-10{% endif %} mx-auto max-w-2xl">
            {% if item.title %}<h3 class="font-display text-2xl font-semibold">{{ item.title }}</h3>{% endif %}
            {% if item.subtitle %}<p class="mt-1 text-sm uppercase tracking-wide text-walnut/50">{{ item.subtitle }}</p>{% endif %}
            {% if item.text %}<div class="mt-4 leading-relaxed text-walnut/75">{{ item.text|rich_block }}</div>{% endif %}
            {% if item.image %}
            <img class="mt-6 h-72 w-full rounded-[var(--brand-radius)] object-cover" src="{{ item.image starts with 'http' ? item.image : '/' ~ item.image }}" alt="{{ item.title|default('') }}" loading="lazy">
            {% endif %}
        </div>

    {% elseif layout == 'image-background' %}
        {% set item = activeItems|first %}
        <div class="{% if heading or kicker %}mt-10{% endif %} relative flex min-h-[420px] items-end overflow-hidden rounded-[var(--brand-radius)]">
            {% if item.image %}
            <img class="absolute inset-0 h-full w-full object-cover" src="{{ item.image starts with 'http' ? item.image : '/' ~ item.image }}" alt="{{ item.title|default('') }}" loading="lazy">
            {% endif %}
            <div class="absolute inset-0 bg-gradient-to-t from-walnut/90 via-walnut/40 to-walnut/5"></div>
            <div class="relative p-8 text-ash md:p-12">
                {% if item.title %}<h3 class="font-display text-2xl font-semibold md:text-3xl">{{ item.title }}</h3>{% endif %}
                {% if item.subtitle %}<p class="mt-1 text-sm uppercase tracking-wide text-ash/70">{{ item.subtitle }}</p>{% endif %}
                {% if item.text %}<div class="mt-4 max-w-xl leading-relaxed text-ash/85">{{ item.text|rich_block }}</div>{% endif %}
            </div>
        </div>

    {% else %}
        {% set colsClass = layout == 'columns-3' ? 'grid-cols-1 gap-10 md:grid-cols-3' : (layout == 'columns-2' ? 'grid-cols-1 gap-10 md:grid-cols-2' : 'grid-cols-1 gap-10 max-w-2xl') %}
        <div class="{% if heading or kicker %}mt-10{% endif %} grid {{ colsClass }}">
            {% for item in activeItems %}
            <div>
                {% if item.image %}
                <img class="h-48 w-full rounded-[var(--brand-radius)] object-cover" src="{{ item.image starts with 'http' ? item.image : '/' ~ item.image }}" alt="{{ item.title|default('') }}" loading="lazy">
                {% endif %}
                {% if item.title %}<h3 class="{% if item.image %}mt-4{% endif %} font-display text-xl font-semibold">{{ item.title }}</h3>{% endif %}
                {% if item.subtitle %}<p class="mt-1 text-sm uppercase tracking-wide text-walnut/50">{{ item.subtitle }}</p>{% endif %}
                {% if item.text %}<div class="mt-3 leading-relaxed text-walnut/75">{{ item.text|rich_block }}</div>{% endif %}
            </div>
            {% endfor %}
        </div>
    {% endif %}
</section>
