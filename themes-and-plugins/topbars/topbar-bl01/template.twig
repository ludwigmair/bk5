{% set hours = content.business.hours|default('') %}
{% set phone = content.business.phone|default('') %}
{% set mobile = content.business.mobile|default('') %}
{% set street = content.business.street|default('') %}
{% set addressLine = (content.business.zip|default('') ~ ' ' ~ content.business.city|default(''))|trim %}
{% set email = content.business.email|default('') %}
<div class="bg-walnut text-ash">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-8 gap-y-1 px-4 py-2.5 text-sm md:justify-between md:px-8">
        {% if hours %}
        <span class="flex items-center gap-2 text-ash/85">
            <svg class="h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            {{ hours }}
        </span>
        {% endif %}
        {% if phone or mobile %}
        <span class="flex items-center gap-2 text-ash/85">
            <svg class="h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2a1 1 0 0 1 1.1-.2c1.2.5 2.5.8 3.8.8a1 1 0 0 1 1 1v3.4a1 1 0 0 1-1 1C10.6 21.2 2.8 13.4 2.8 3.7a1 1 0 0 1 1-1H7.2a1 1 0 0 1 1 1c0 1.3.3 2.6.8 3.8a1 1 0 0 1-.2 1.1L6.6 10.8Z"/></svg>
            {% if phone %}<a class="hover:text-secondary" href="tel:{{ phone|replace({' ': ''}) }}">{{ phone }}</a>{% endif %}
            {% if phone and mobile %}<span class="text-ash/40">|</span>{% endif %}
            {% if mobile %}<a class="hover:text-secondary" href="tel:{{ mobile|replace({' ': ''}) }}">{{ mobile }}</a>{% endif %}
        </span>
        {% endif %}
        {% if street or addressLine %}
        <span class="flex items-center gap-2 text-ash/85">
            <svg class="h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.1 7-11.5A7 7 0 0 0 5 9.5C5 14.9 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
            {{ street }}{% if street and addressLine %},{% endif %} {{ addressLine }}
        </span>
        {% endif %}
        {% if email %}
        <span class="flex items-center gap-2 text-ash/85">
            <svg class="h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            <a class="hover:text-secondary" href="mailto:{{ email }}" data-mail-template data-mail-address="{{ email }}" data-mail-subject="{{ content.labels.mail_subject|default('') }}" data-mail-body="{{ content.labels.mail_body|default('') }}">{{ email }}</a>
        </span>
        {% endif %}
    </div>
</div>