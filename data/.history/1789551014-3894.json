        {
            "id": "mobiliar-1",
            "type": "content-block",
            "sort": 60,
            "label": "Mobiliar",
            "group": "",
            "background": "auto",
            "data": {
                "kicker": {
                    "de": "Mobiliar"
                },
                "heading": {
                    "de": "Maßgefertigte Polstermöbel & exklusive Polstermanufaktur"
                },
                "layout": "image-left",
                "items": [
                    {
                        "image": "uploads/sofa-loft.webp",
                        "title": {
                            "de": "Von der Stange passt selten perfekt"
                        },
                        "subtitle": {
                            "de": ""
                        },
                        "text": {
                            "de": "Ein Möbelstück von der Stange passt selten perfekt zum eigenen Lebensgefühl. Als erfahrener Meisterbetrieb erwecken wir Ihre Lieblingsstücke zu neuem Leben oder erschaffen individuelle Unikate von Grund auf neu.\r\n\r\nIn der hauseigenen Polsterei in Vachendorf bei Traunstein verarbeiten wir edelste Bezugsmaterialien mit traditioneller Handwerkskunst. Für die Neuanfertigung von maßgeschneiderten Sofas, Sesseln oder individuellen Polsterbetten arbeiten wir exklusiv mit einer renommierten Polstermanufaktur in Spanien zusammen.\r\n\r\n- JAB Anstoetz & Chivasso (Zeitlose Eleganz und moderne Texturen)\r\n- Christian Fischbacher (Schweizer Luxusstoffe und edle Seide)\r\n- Romo & Black Edition (Innovative Designs und exklusive Haptik)\r\n- Colefax and Fowler (Klassischer englischer Stil und feinste Webarten)\r\n- Zimmer + Rohde sowie Saum & Viebahn (Hochwertige Funktions- und Dekostoffe)"
                        },
                        "person_name": {
                            "de": ""
                        },
                        "person_role": {
                            "de": ""
                        },
                        "cta_label": {
                            "de": ""
                        },
                        "cta_href": "",
                        "active": true
                    }
                ]
            }
        },
