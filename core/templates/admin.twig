      (function () {
        var panels = document.querySelectorAll('.section-panel');
        var navLinks = document.querySelectorAll('.section-nav-link');
        if (!panels.length || !navLinks.length) return;

        function activate(id) {
          panels.forEach(function (p) {
            var match = p.getAttribute('data-panel') === id;
            p.hidden = !match;
            p.style.display = match ? '' : 'none';
          });
          navLinks.forEach(function (a) {
            a.classList.toggle('is-active', a.getAttribute('href') === '#' + id);
          });
        }

        function fromHash() {
          var id = (location.hash || '').replace('#', '');
          if (!id || !document.getElementById(id)) {
            id = document.getElementById('panel-site') ? 'panel-site' : navLinks[0].getAttribute('href').slice(1);
          }
          activate(id);
        }

        window.addEventListener('hashchange', fromHash);
        fromHash();
      })();

      document.addEventListener('submit', function (e) {
        if (e.defaultPrevented) return; // z. B. abgebrochener Löschen-Dialog
        var btn = e.submitter;
        if (!btn || btn.tagName !== 'BUTTON' || btn.disabled) return;
        btn.dataset.label = btn.textContent;
        btn.textContent = 'Bitte warten …';
        btn.disabled = true;
        btn.classList.add('opacity-60', 'cursor-wait');
      });

      // Vor dem Content-Speichern merken, welches Panel gerade offen ist und wie
      // weit gescrollt war - der Server antwortet mit #panel-... + ?focus_scroll=
      // (siehe saveContent()/redirectToEdited()), damit man nach dem Reload an
      // derselben Stelle weiterarbeitet statt wieder ganz oben.
      document.addEventListener('submit', function (e) {
        var form = e.target;
        if (!form || form.id !== 'content-form') return;
        var active = document.querySelector('.section-panel:not([hidden])');
        var panelInput = form.querySelector('input[name="focus_panel"]');
        var scrollInput = form.querySelector('input[name="focus_scroll"]');
        if (panelInput) panelInput.value = active ? active.getAttribute('data-panel') : '';
        if (scrollInput) scrollInput.value = String(Math.max(0, Math.round(window.scrollY)));
      });

      // Zurück zur bearbeiteten Stelle nach dem Speichern: der Fragment-Scroll
      // des Browsers (aufs Panel) und nachgeladene Bilder/Schriften würden die
      // Position sofort wieder überschreiben - deshalb erst nach load scrollen,
      // einmal nachziehen, und nur solange der Nutzer selbst nicht scrollt.
      (function () {
        var params = new URLSearchParams(location.search);
        var want = parseInt(params.get('focus_scroll') || '', 10);
        if (!(want > 0)) return;
        params.delete('focus_scroll');
        var query = params.toString();
        history.replaceState(null, '', location.pathname + (query ? '?' + query : '') + location.hash);

        var touched = false;
        ['wheel', 'touchmove', 'keydown'].forEach(function (ev) {
          window.addEventListener(ev, function () { touched = true; }, { passive: true });
        });
        function apply() {
          if (touched) return;
          window.scrollTo(0, want);
        }
        window.addEventListener('load', function () {
          apply();
          setTimeout(apply, 400);
        });
      })();

      (function () {
        var modal = document.getElementById('confirm-modal');
        if (!modal) return;
        var msgEl = modal.querySelector('[data-confirm-message]');
        var titleEl = modal.querySelector('[data-confirm-title]');
        var okBtn = modal.querySelector('[data-confirm-ok]');
        var pendingForm = null;

        function open(form, message) {
          pendingForm = form;
          msgEl.textContent = message;
          titleEl.textContent = form.dataset.confirmTitle || 'Wirklich löschen?';
          okBtn.textContent = form.dataset.confirmAction || 'Löschen';
          var isPrimary = form.dataset.confirmVariant === 'primary';
          okBtn.classList.toggle('bg-red-700', !isPrimary);
          okBtn.classList.toggle('hover:bg-red-800', !isPrimary);
          okBtn.classList.toggle('bg-[#355E4B]', isPrimary);
          okBtn.classList.toggle('hover:brightness-110', isPrimary);
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
        function close() {
          pendingForm = null;
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }

        document.addEventListener('submit', function (e) {
          var form = e.target;
          var message = form.getAttribute && form.getAttribute('data-confirm');
          if (!message) return;
          if (form.dataset.confirmed === '1') {
            delete form.dataset.confirmed;
            return;
          }
          e.preventDefault();
          open(form, message);
        }, true);

        modal.querySelector('[data-confirm-cancel]').addEventListener('click', close);
        modal.querySelector('[data-confirm-ok]').addEventListener('click', function () {
          if (pendingForm) {
            pendingForm.dataset.confirmed = '1';
            pendingForm.requestSubmit();
          }
          close();
        });
        modal.addEventListener('click', function (e) {
          if (e.target === modal) close();
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !modal.classList.contains('hidden')) close();
        });
      })();

      (function () {
        var bulkForm = document.getElementById('bulk-delete-form');
        if (!bulkForm) return;
        var boxes = Array.prototype.slice.call(document.querySelectorAll('[data-bulk-image]'));
        var btn = bulkForm.querySelector('[data-bulk-delete]');
        var countEl = bulkForm.querySelector('[data-bulk-count]');
        var allToggle = document.querySelector('[data-bulk-select-all]');
        function refresh() {
          var n = boxes.filter(function (b) { return b.checked; }).length;
          countEl.textContent = String(n);
          btn.disabled = n === 0;
          if (allToggle) allToggle.checked = n > 0 && n === boxes.length;
          bulkForm.dataset.confirm = n > 1 ? n + ' Bilder wirklich löschen?' : (n === 1 ? 'Bild wirklich löschen?' : '');
        }
        boxes.forEach(function (b) { b.addEventListener('change', refresh); });
        if (allToggle) allToggle.addEventListener('change', function () {
          boxes.forEach(function (b) { b.checked = allToggle.checked; });
          refresh();
        });
        refresh();
      })();

      (function () {
        var modal = document.getElementById('discard-modal');
        var discardBtn = document.querySelector('[data-discard-changes]');
        if (!modal || !discardBtn) return;

        function open() {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
        function close() {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }

        discardBtn.addEventListener('click', open);
        modal.querySelector('[data-modal-cancel]').addEventListener('click', close);
        modal.querySelector('[data-modal-confirm]').addEventListener('click', function () {
          location.reload();
        });
        modal.addEventListener('click', function (e) {
          if (e.target === modal) close();
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !modal.classList.contains('hidden')) close();
        });
      })();

      document.addEventListener('click', function (e) {
        var resetBtn = e.target.closest('[data-theme-form-reset]');
        if (resetBtn) {
          var form = document.querySelector('[data-theme-form]');
          if (!form) return;
          form.querySelector('input[name="theme_label"]').value = '';
          form.querySelector('input[name="theme_description"]').value = '';
          form.querySelectorAll('select').forEach(function (select) {
            select.selectedIndex = 0;
          });
          form.querySelectorAll('input[name="languages[]"]').forEach(function (cb) {
            cb.checked = cb.disabled;
          });
          form.querySelector('input[name="theme_label"]').focus();
          return;
        }

        var editLink = e.target.closest('[data-theme-edit]');
        if (editLink) {
          var themeForm = document.querySelector('[data-theme-form]');
          if (!themeForm) return;
          themeForm.querySelector('input[name="theme_label"]').value = editLink.dataset.label || '';
          themeForm.querySelector('input[name="theme_description"]').value = editLink.dataset.description || '';
          ['header', 'footer', 'topbar', 'stickybar', 'cookiebanner'].forEach(function (region) {
            var select = themeForm.querySelector('select[name="regions[' + region + ']"]');
            var value = editLink.dataset[region];
            if (select && value !== undefined) select.value = value;
          });
          var langs = (editLink.dataset.languages || 'de').split(',');
          themeForm.querySelectorAll('input[name="languages[]"]').forEach(function (cb) {
            cb.checked = cb.disabled || langs.indexOf(cb.value) !== -1;
          });
          var builder = document.getElementById('theme-builder');
          if (builder) builder.scrollIntoView({ behavior: 'smooth' });
          updateThemeRegionWarning();
        }
      });

      // Hinweis im Theme-Formular, wenn Header oder Footer auf "— Keine —" steht.
      function updateThemeRegionWarning() {
        var form = document.querySelector('[data-theme-form]');
        var hint = form && form.querySelector('[data-theme-region-warning]');
        if (!hint) return;
        var missing = ['header', 'footer'].some(function (region) {
          var select = form.querySelector('select[name="regions[' + region + ']"]');
          return select && select.value === '';
        });
        hint.classList.toggle('hidden', !missing);
      }
      document.addEventListener('change', function (e) {
        if (e.target.matches && e.target.matches('[data-theme-form] select[name^="regions["]')) updateThemeRegionWarning();
      });
      updateThemeRegionWarning();
    </script>
</body>
</html>
