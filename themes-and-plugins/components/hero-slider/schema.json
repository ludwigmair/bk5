                { "value": "stacked", "label": "Bildkarussell oben, Text separat darunter" },
                { "value": "split", "label": "Geteilt: Text neben Bildkarussell" }
            ]
        },
        {
            "name": "kicker",
            "type": "text",
            "label": "Kicker",
            "ai_supported": true
        },
