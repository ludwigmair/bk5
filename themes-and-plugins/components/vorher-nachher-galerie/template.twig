{% set activeItems = items|default([])|filter(item => item.active is not defined or item.active) %}

<section id="{{ id }}" class="mx-auto max-w-6xl px-4 py-20 md:px-8">
    {% if kicker %}
    <p class="font-display text-xs font-medium uppercase tracking-[0.28em] text-primary">{{ kicker }}</p>
    {% endif %}
    {% if heading %}
    <h2 class="mt-2 font-display text-3xl font-semibold md:text-4xl">{{ heading }}</h2>
    {% endif %}
    {% if lead %}
    <p class="mt-4 max-w-2xl leading-relaxed text-walnut/75">{{ lead|rich }}</p>
    {% endif %}

    <div class="{% if heading or kicker or lead %}mt-10{% endif %} grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {% for item in activeItems %}
        <div class="overflow-hidden rounded-[var(--brand-radius)] border border-walnut/15 bg-ash/50">
            <div class="grid grid-cols-2 gap-px bg-walnut/15">
                <button type="button" class="group relative h-36 cursor-pointer overflow-hidden md:h-40" data-vng-open data-vng-lightbox-target="{{ id }}" data-vng-index="{{ loop.index0 }}" data-vng-start="0">
                    {% if item.before_image %}
                    <img class="h-full w-full object-cover transition duration-300 group-hover:scale-105" src="{{ item.before_image starts with 'http' ? item.before_image : '/' ~ item.before_image }}" alt="{{ item.title|default('') }} – vorher" loading="lazy">
                    {% endif %}
                    <span class="absolute bottom-2.5 left-2.5 rounded-full bg-walnut/60 px-2.5 py-1 font-display text-[11px] font-bold uppercase tracking-[0.08em] text-white">Vorher</span>
                </button>
                <button type="button" class="group relative h-36 cursor-pointer overflow-hidden md:h-40" data-vng-open data-vng-lightbox-target="{{ id }}" data-vng-index="{{ loop.index0 }}" data-vng-start="1">
                    {% if item.after_image %}
                    <img class="h-full w-full object-cover transition duration-300 group-hover:scale-105" src="{{ item.after_image starts with 'http' ? item.after_image : '/' ~ item.after_image }}" alt="{{ item.title|default('') }} – nachher" loading="lazy">
                    {% endif %}
                    <span class="absolute bottom-2.5 left-2.5 rounded-full bg-walnut/60 px-2.5 py-1 font-display text-[11px] font-bold uppercase tracking-[0.08em] text-white">Nachher</span>
                </button>
            </div>
            <div class="px-5 py-5">
                {% if item.title %}<h3 class="font-display text-lg font-semibold">{{ item.title }}</h3>{% endif %}
                {% if item.text %}<div class="mt-2 text-sm leading-relaxed text-walnut/70">{{ item.text|rich_block }}</div>{% endif %}
            </div>
        </div>
        {% endfor %}
    </div>
</section>

{% if activeItems|length > 0 %}
<div class="fixed inset-0 z-50 hidden items-center justify-center bg-walnut/80 p-4 backdrop-blur-sm" data-vng-lightbox="{{ id }}">
    <button type="button" class="absolute right-4 top-4 z-10 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full bg-white/10 text-ash transition hover:bg-white/20" data-vng-close aria-label="Schließen">✕</button>
    <div class="max-h-[90vh] w-full max-w-3xl overflow-y-auto">
        {% for item in activeItems %}
        <div class="{% if not loop.first %}hidden{% endif %}" data-vng-panel="{{ loop.index0 }}">
            <div class="relative h-[50vh] overflow-hidden rounded-[var(--brand-radius)] md:h-[60vh]" data-crossfade>
                {% if item.before_image %}
                <div class="absolute inset-0 opacity-100" data-crossfade-slide>
                    <img class="h-full w-full object-cover" src="{{ item.before_image starts with 'http' ? item.before_image : '/' ~ item.before_image }}" alt="{{ item.title|default('') }} – vorher" loading="lazy">
                    <span class="absolute bottom-3 left-3 rounded-full bg-walnut/60 px-2.5 py-1 font-display text-[11px] font-bold uppercase tracking-[0.08em] text-white">Vorher</span>
                </div>
                {% endif %}
                {% if item.after_image %}
                <div class="absolute inset-0 opacity-0" data-crossfade-slide>
                    <img class="h-full w-full object-cover" src="{{ item.after_image starts with 'http' ? item.after_image : '/' ~ item.after_image }}" alt="{{ item.title|default('') }} – nachher" loading="lazy">
                    <span class="absolute bottom-3 left-3 rounded-full bg-walnut/60 px-2.5 py-1 font-display text-[11px] font-bold uppercase tracking-[0.08em] text-white">Nachher</span>
                </div>
                {% endif %}
                {% if item.before_image and item.after_image %}
                <button type="button" class="swiper-nav-btn hero-nav-arrow !absolute bottom-3 left-3 z-10" data-crossfade-prev aria-label="Vorheriges Bild">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <button type="button" class="swiper-nav-btn hero-nav-arrow !absolute bottom-3 right-3 z-10" data-crossfade-next aria-label="Nächstes Bild">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                {% endif %}
            </div>
            <div class="mt-4 text-ash">
                {% if item.title %}<h3 class="font-display text-xl font-semibold">{{ item.title }}</h3>{% endif %}
                {% if item.text %}<div class="mt-2 leading-relaxed text-ash/80">{{ item.text|rich_block }}</div>{% endif %}
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}
